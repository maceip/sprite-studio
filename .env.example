# Character sprite generation via OpenAI API directly
OPENAI_API_KEY=

# OpenRouter API key (for animations, and optional fallback for characters)
OPENROUTER_API_KEY=

# ElevenLabs API key (for Sound & SFX)
ELEVENLABS_API_KEY=

# Optional: explicitly select image provider ('openai' or 'openrouter')
# IMAGE_PROVIDER=openai

# Optional: custom OpenAI base URL (defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
